#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

mkdir -p config
if [[ ! -f config/configuration.yaml ]]; then
  cp scripts/dev_configuration.yaml config/configuration.yaml
fi

export PYTHONPATH="${PYTHONPATH:-}:${PWD}/custom_components"
exec python3 -m homeassistant --config "${PWD}/config" --debug
